# ============================================================
# Telegram downloader bot
# Copy to .env and fill in. Only the first line is required.
# ============================================================

# --- REQUIRED ---
TELEGRAM_BOT_TOKEN=

# ============================================================
# Everything below is OPTIONAL. The bot runs fine with none of it:
#   Spotify  - needs no keys (metadata comes from public embed pages)
#   YouTube  - needs no cookies (alternative player clients are used)
#   Instagram- reels and video posts work anonymously
# ============================================================

# --- Instagram (only for stories + multi-photo carousels) ---
# Browser cookies from a throwaway account.
# DevTools > Application > Cookies > instagram.com
INSTAGRAM_USERNAME=
IG_SESSIONID=
IG_CSRFTOKEN=
IG_DS_USER_ID=

# --- Local Bot API server (lifts the 50MB upload cap to 2GB) ---
# Run the aiogram/telegram-bot-api container, then set both lines:
#   BOT_API_BASE_URL=http://127.0.0.1:8081
#   MAX_UPLOAD_MB=2000
BOT_API_BASE_URL=
MAX_UPLOAD_MB=50

# --- YouTube cookies (rarely needed; leave empty) ---
# Only set this if age-restricted or region-locked videos keep failing.
# A path that does not exist is ignored automatically.
YT_COOKIES_FILE=

# --- Spotify (only for playlists over ~100 tracks) ---
# The keyless embed page caps out around 100 entries, so a large playlist
# cannot be listed without these. developer.spotify.com/dashboard -> Create app.
# Spotify's own editorial playlists (37i9...) stay blocked for new free apps.
#
# NOTE: Spotify now requires the ACCOUNT THAT OWNS THE APP to hold an active
# Premium subscription. Without one every endpoint answers 403 - credentials
# and token both valid - and the bot silently falls back to the embed page,
# so long playlists just come back short. Run /srcstatus in the bot to see
# whether it is actually working. Premium also unlocks ISRC lookup, which
# identifies the exact recording behind a Spotify link instead of matching it
# by name and runtime.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Sponsor channel lock (optional) ---
# Users must join this channel before the bot answers. The bot must be an
# ADMIN of it, otherwise membership cannot be checked (and the gate then lets
# everyone through rather than locking the bot). Empty = no gate.
REQUIRED_CHANNEL=

# --- Admin panel ---
# Telegram numeric user ids allowed to run /admin. Send /id to the bot to
# learn yours. Comma-separated; empty disables the panel.
ADMIN_IDS=

# --- Audio format: m4a (default, fastest) | mp3 | flac ---
# Sources are lossy, so flac only inflates the file size.
AUDIO_FORMAT=m4a

# --- Extra music-recognition engines (optional) ---
# Shazam always runs first and needs no key or quota. These are tried only
# when it finds nothing, in the order listed here.
#
# acoustid: FREE and effectively unlimited. Fingerprints the exact recording
#   via AcoustID + MusicBrainz, so it catches clean audio files Shazam misses
#   (and is weak on noisy phone captures - the opposite of Shazam).
#   Key: https://acoustid.org/new-application  (instant, free)
#   Needs fpcalc, which the installer adds (libchromaprint-tools).
# audd: commercial, best on hard clips, small free quota. Optional.
#   https://audd.io
#
# An engine that errors or runs out of quota is skipped for 15 minutes, so a
# spent allowance quietly falls back to Shazam instead of breaking anything.
ACOUSTID_API_KEY=
AUDD_API_TOKEN=
RECOGNITION_ENGINES=acoustid,audd

# --- Lyrics sources, in priority order (all free, no keys) ---
# lrclib     the only one with time-synced lyrics; best when it has the track
# lyricsovh  different catalogue, fills many of lrclib's gaps
# genius     widest coverage (hip-hop, album cuts); scraped from the page, and
#            its result is checked against the song asked for, because Genius
#            answers with its nearest guess rather than nothing
LYRICS_SOURCES=lrclib,lyricsovh,genius

# --- Resource limits (protect the server from one big request) ---
# Downloads running at once across ALL users; near the core count is right.
MAX_CONCURRENT_DOWNLOADS=4
# ...and how many of those a single user may hold.
MAX_DOWNLOADS_PER_USER=2
# Batch (playlist/album) downloads one user may run at a time.
MAX_ACTIVE_BATCHES_PER_USER=1
# Cap on the downloads directory; the oldest files are removed past this.
MAX_DISK_MB=8000

# --- Misc ---
DOWNLOAD_DIR=./downloads
LOG_LEVEL=INFO
