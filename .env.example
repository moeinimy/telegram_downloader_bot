# ============================================================
# Telegram downloader bot
# Copy to .env and fill in. Only the first line is required.
# ============================================================

# --- REQUIRED ---
TELEGRAM_BOT_TOKEN=

# ============================================================
# Everything below is OPTIONAL. The bot runs fine with none of it:
#   Spotify  - needs no keys (metadata comes from public embed pages)
#   YouTube  - needs no cookies (alternative player clients are used)
#   Instagram- reels and video posts work anonymously
# ============================================================

# --- Instagram (only for stories + multi-photo carousels) ---
# Browser cookies from a throwaway account.
# DevTools > Application > Cookies > instagram.com
INSTAGRAM_USERNAME=
IG_SESSIONID=
IG_CSRFTOKEN=
IG_DS_USER_ID=

# ============================================================
# --- Instagram Direct: share to our IG DMs, get it in Telegram ---
# ============================================================
# The user enables this in the bot, gets a one-time pairing token, DMs that
# token to OUR Instagram account, and from then on anything they share to
# that DM comes back to them in Telegram, already downloaded.
#
# Two independent ways to read the inbox. Both may be listed; the second is
# a standby that only wakes up when the first stops answering a health check.
#   webhook  official Instagram Platform API. Survives, but see the access
#            note below. Needs a public HTTPS endpoint.
#   poll     instagrapi logged in as the account. Works for everyone right
#            away but violates Instagram's terms - the account can be
#            disabled without appeal. Left last on purpose.
# Set to just "webhook" to never touch the unofficial path.
#   web      Instagram's WEB api, using the cookies from your own browser.
#            No login, no device, nothing signed - the cookie IS the session,
#            and this is the api it was issued for. Prefer this one.
IG_DIRECT_SOURCES=webhook,web,poll

# --- webhook (official) ---
#
# ACCESS NOTE, read this before wondering why nothing arrives: with STANDARD
# access the messages webhook only fires for accounts that have a role on
# your app (App Dashboard -> Roles -> Instagram Testers, max 25). For the
# general public you need ADVANCED access on instagram_business_manage_messages,
# which means App Review - and Review requires a working callback URL, so the
# HTTPS endpoint below has to be live BEFORE you submit.
#
# The receiving account must be a PROFESSIONAL account (Business or Creator),
# and in the Instagram app: Settings -> Messages -> allow connected tools to
# access messages. Without that the webhook stays silent no matter what.
#
# developers.facebook.com -> your app -> Instagram -> Business Login
IG_APP_ID=
IG_APP_SECRET=
# Long-lived token (60 days) from the Business Login flow. The bot refreshes
# it automatically, but a token left UNUSED for 60 days dies permanently and
# cannot be refreshed - so do not disable the bot for two months.
IG_ACCESS_TOKEN=
# Any random string; Meta echoes it back during the subscription handshake.
#   openssl rand -hex 16
IG_VERIFY_TOKEN=

# Where aiohttp listens. Keep it on loopback - Caddy/nginx terminates TLS and
# proxies to it. Meta only delivers to public HTTPS with a trusted cert, so a
# bare IP will never work.
IG_WEBHOOK_HOST=127.0.0.1
IG_WEBHOOK_PORT=8088
IG_WEBHOOK_PATH=/ig/webhook
# The public URL of the line above. This is the exact string you paste into
# Meta's callback URL field, and what /srcstatus reports.
#   e.g. https://ig.example.com/ig/webhook
IG_PUBLIC_URL=

# How often the official path is health-checked (token still valid, webhook
# still subscribed). A failed check is what wakes the standby source - not
# silence, because a quiet inbox is normal and proves nothing.
IG_HEALTH_MINUTES=10

# --- poll (unofficial, standby) ---
# Needs instagrapi, which is deliberately NOT in requirements.txt: it pins
# pydantic and would fight shazamio's resolver. Install it separately with
#   botctl igdirect      (or option 15 in the menu)
# If it is not installed, this source is skipped and the bot starts normally.
#
# Strongly prefer a SECOND Instagram account here. Logging in with an
# unofficial client to the same account that holds the official API token is
# the combination most likely to get it banned.
IG_DM_USERNAME=
# Prefer the sessionid. A username/password login originating from this server
# is a login context Instagram does not trust, and it answers:
#
#   BadPassword: We can send you an email to help you get back into your
#   account. This can also happen when Instagram rejects the proxy/IP, device
#   fingerprint, or login context, even if the password is correct.
#
# The password is correct in that message. The IP is the problem. With a
# sessionid the sign-in already happened in your browser, where Instagram
# trusts it, and the server only carries the result.
#
#   browser -> instagram.com -> F12 -> Application -> Cookies
#
# Take all THREE. With csrftoken and ds_user_id the "web" source above can be
# used, which is the api this cookie actually belongs to. Handing a browser
# cookie to the mobile api instead is what produced:
#
#     403 Forbidden  https://i.instagram.com/api/v1/users/<id>/info/
#     instagrapi.exceptions.LoginRequired: login_required
#
# and no device fingerprint, proxy or fresh cookie fixes that - none of them
# change which api the cookie belongs to.
IG_DM_SESSIONID=
IG_DM_CSRFTOKEN=
IG_DM_DS_USER_ID=
IG_DM_PASSWORD=

# Route instagrapi through a proxy. socks5:// works here (requests speaks
# SOCKS), unlike SHAZAM_PROXY which is http-only.
#
# Needed when Instagram refuses this server's address. The tell is a 403 html
# page on calls that have nothing to do with your account - during sign-in,
# users/<id>/info/ came back as:
#
#     403 Client Error: Forbidden for url:
#     https://i.instagram.com/api/v1/users/.../info/
#
# followed by "Exceeded 30 redirects". If Shazam is also answering this host
# with a 403 page, it is the IP: two unrelated services do not both break on
# the same day for unrelated reasons.
IG_DM_PROXY=

# Polling has no push channel, so the interval IS the latency - there is no
# way to be told about a DM, only to ask. Asking every second around the clock
# is ~3600 requests an hour against a private API and is the surest way to
# lose the account, so the loop has two speeds.
#
#   IG_DM_POLL_SECONDS   idle speed, when nothing has arrived recently
#   IG_DM_FAST_SECONDS   speed for FAST_WINDOW seconds after any message
#   IG_DM_FAST_WINDOW    how long one message keeps the loop fast
#
# Sharing is bursty: someone sends the pairing token and then three reels
# inside a minute. The first one waits up to POLL_SECONDS; everything after it
# lands in about FAST_SECONDS.
#
# For permanently-instant, set IG_DM_POLL_SECONDS=1 as well - and understand
# that you are choosing ~3600 requests/hour and the ban risk that carries.
# A throttle response backs the loop off automatically, doubling each time.
# These defaults were 2s and 1s. At that rate the account was blocked within
# a day - Instagram started answering every private call with:
#
#     403  error_code 1404006  "something went wrong, please try again"
#
# ~3600 automated requests an hour from a datacenter address is simply
# visible. 8s idle / 3s hot is roughly 500/hour and still feels immediate for
# the second and third thing somebody shares.
#
# Fractional seconds work and the floor is 0.3, but understand what you are
# choosing: the account, not the latency, is the thing at risk.
IG_DM_POLL_SECONDS=8
IG_DM_FAST_SECONDS=3
IG_DM_FAST_WINDOW=120

# --- Local Bot API server (lifts the 50MB upload cap to 2GB) ---
# Run the aiogram/telegram-bot-api container, then set both lines:
#   BOT_API_BASE_URL=http://127.0.0.1:8081
#   MAX_UPLOAD_MB=2000
BOT_API_BASE_URL=
MAX_UPLOAD_MB=50

# --- YouTube cookies (rarely needed; leave empty) ---
# Only set this if age-restricted or region-locked videos keep failing.
# A path that does not exist is ignored automatically.
YT_COOKIES_FILE=

# --- Spotify (only for playlists over ~100 tracks) ---
# The keyless embed page caps out around 100 entries, so a large playlist
# cannot be listed without these. developer.spotify.com/dashboard -> Create app.
# Spotify's own editorial playlists (37i9...) stay blocked for new free apps.
#
# NOTE: Spotify now requires the ACCOUNT THAT OWNS THE APP to hold an active
# Premium subscription. Without one every endpoint answers 403 - credentials
# and token both valid - and the bot silently falls back to the embed page,
# so long playlists just come back short. Run /srcstatus in the bot to see
# whether it is actually working. Premium also unlocks ISRC lookup, which
# identifies the exact recording behind a Spotify link instead of matching it
# by name and runtime.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Sponsor channel lock (optional) ---
# Users must join this channel before the bot answers. The bot must be an
# ADMIN of it, otherwise membership cannot be checked (and the gate then lets
# everyone through rather than locking the bot). Empty = no gate.
REQUIRED_CHANNEL=

# --- Admin panel ---
# Telegram numeric user ids allowed to run /admin. Send /id to the bot to
# learn yours. Comma-separated; empty disables the panel.
ADMIN_IDS=

# --- Video subtitles (the "زیرنویس ویدیو" button) ---
# Two backends. Set up with:  botctl whisper
#
# API - preferred, and not a close call. It runs whisper-large-v3, which is
# the model that actually gets Persian right, and it costs this server no CPU
# at all. Any OpenAI-compatible /audio/transcriptions endpoint works.
# Groq's free tier is 8 hours of audio a day: https://console.groq.com/keys
WHISPER_API_URL=https://api.groq.com/openai/v1
WHISPER_API_KEY=
WHISPER_API_MODEL=whisper-large-v3
#
# Local fallback (faster-whisper, optional install). Used only when no API key
# is set, or when the API call fails.
#
# Model size IS the Persian quality, and it is paid for in CPU time. Measured
# on this project's VPS: large-v3-turbo took five minutes for one clip and
# occupied the machine while it ran. small and below produce Persian that is
# essentially invented - real words, no meaning.
WHISPER_MODEL=medium
# Cores it may use. 0 = half of them. Left to the library it takes every core
# and the bot cannot download anything until the transcription finishes.
WHISPER_CPU_THREADS=0

# --- Audio format: m4a (default, fastest) | mp3 | flac ---
# Sources are lossy, so flac only inflates the file size.
AUDIO_FORMAT=m4a

# --- Extra music-recognition engines (optional) ---
# Shazam always runs first and needs no key or quota. These are tried only
# when it finds nothing, in the order listed here.
#
# acoustid: FREE and effectively unlimited. Fingerprints the exact recording
#   via AcoustID + MusicBrainz, so it catches clean audio files Shazam misses
#   (and is weak on noisy phone captures - the opposite of Shazam).
#   Key: https://acoustid.org/new-application  (instant, free)
#   Needs fpcalc, which the installer adds (libchromaprint-tools).
# audd: commercial, best on hard clips, small free quota. Optional.
#   https://audd.io
#
# An engine that errors or runs out of quota is skipped for 15 minutes, so a
# spent allowance quietly falls back to Shazam instead of breaking anything.
ACOUSTID_API_KEY=
AUDD_API_TOKEN=
RECOGNITION_ENGINES=acoustid,audd

# Route Shazam through a proxy, e.g. http://user:pass@host:port
#
# Needed when Shazam refuses this server's address. It does not return an
# error in that case - it returns an HTML block page, shazamio fails to parse
# it, and every window comes back empty:
#
#     Shazam error on 00.mp4: FailedDecodeJson: Failed to decode json
#
# which reaches the user as "I couldn't identify any music". Datacenter IPs
# get this; residential ones generally do not. No amount of retrying helps -
# the request has to leave from somewhere else.
#
# http:// and socks5h:// both work. SOCKS needs aiohttp-socks, which
# `botctl proxy` installs - without it a socks url is ignored, which looks
# exactly like having set nothing.
#
# Setting ACOUSTID_API_KEY above is the other half of the answer: it is free,
# effectively unlimited, and it now runs even when Shazam is refusing us.
#
# Check what Shazam actually answers this server with:  botctl shazamtest
SHAZAM_PROXY=

# --- Lyrics sources, in priority order (all free, no keys) ---
# lrclib     the only one with time-synced lyrics; best when it has the track
# lyricsovh  different catalogue, fills many of lrclib's gaps
# genius     widest coverage (hip-hop, album cuts); scraped from the page, and
#            its result is checked against the song asked for, because Genius
#            answers with its nearest guess rather than nothing
LYRICS_SOURCES=lrclib,lyricsovh,genius

# --- Resource limits (protect the server from one big request) ---
# Downloads running at once across ALL users; near the core count is right.
MAX_CONCURRENT_DOWNLOADS=4
# ...and how many of those a single user may hold.
MAX_DOWNLOADS_PER_USER=2
# Batch (playlist/album) downloads one user may run at a time.
MAX_ACTIVE_BATCHES_PER_USER=1
# Cap on the downloads directory; the oldest files are removed past this.
MAX_DISK_MB=8000

# --- Misc ---
DOWNLOAD_DIR=./downloads
LOG_LEVEL=INFO
