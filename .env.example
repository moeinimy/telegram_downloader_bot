# ============================================================
# Telegram downloader bot - environment config
# Copy this file to .env and fill in the real values.
# .env is git-ignored and must NEVER be committed.
# ============================================================

# --- Telegram (required) ---
TELEGRAM_BOT_TOKEN=

# --- Spotify (required; metadata comes from the embed scraper) ---
SPOTIFY_CLIENT_ID=bc279b38114e424e871d398d85167e87
SPOTIFY_CLIENT_SECRET=

# --- Instagram (optional; needed for stories / photo carousels) ---
# Preferred: browser session cookies from a logged-in throwaway account.
# Browser DevTools > Application > Cookies > instagram.com
INSTAGRAM_USERNAME=
IG_SESSIONID=
IG_CSRFTOKEN=
IG_DS_USER_ID=
# Legacy password login (usually blocked from datacenter IPs; leave empty)
INSTAGRAM_PASSWORD=

# --- Local Bot API server (optional; lifts the 50MB upload cap to 2GB) ---
# Run the aiogram/telegram-bot-api docker container, then set:
#   BOT_API_BASE_URL=http://127.0.0.1:8081
#   MAX_UPLOAD_MB=2000
BOT_API_BASE_URL=
MAX_UPLOAD_MB=50

# --- YouTube cookies (recommended on datacenter/VPS IPs) ---
# Netscape-format cookies.txt exported from a logged-in browser session;
# avoids "Sign in to confirm you're not a bot". Leave blank to disable.
YT_COOKIES_FILE=/opt/telegram_downloader_bot/youtube_cookies.txt

# --- Misc ---
DOWNLOAD_DIR=./downloads
LOG_LEVEL=INFO
